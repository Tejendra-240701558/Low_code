 application "Clinic Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Appointment
		{
			success message = "Appointment Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Patient
			(
				type = picklist	
				values  = Patient.ID
    			displayformat = [Patient_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Doctor
			(
				type = picklist	
				values  = Doctor.ID
    			displayformat = [Doctor]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Appointment_Date
			(
    			type = date
				displayname = "Appointment Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Appointment_Time
			(
    			type = time
				displayname = "Appointment Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Reason_for_Visit
			(
    			type = textarea
				displayname = "Reason for Visit"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Appointment_Type
			(
				type = picklist
				displayname = "Appointment Type"
				maxchar = 100
				values = {"New Consultation","Follow-up","Emergency","Routine Check-up"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = picklist
				maxchar = 100
				values = {"Pending","Approved","Confirmed","Completed","Cancelled","No Show"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Notes
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Appointment_ID
			(
    			type = text
				displayname = "Appointment ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Billing
		{
			success message = "Billing Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Patient
			(
				type = picklist	
				values  = Patient.ID
    			displayformat = [Patient_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Appointment
			(
				type = picklist	
				values  = Appointment.ID
    			displayformat = [Appointment_Date]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Consultation_Fee
			(
				displayname = "Consultation Fee"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Medicine_Charges
			(
				displayname = "Medicine Charges"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Other_Charges
			(
				displayname = "Other Charges"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Discount
			(
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Amount
			(
				displayname = "Total Amount"
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Payment_Status
			(
				type = picklist
				displayname = "Payment Status"
				maxchar = 100
				values = {"Pending","Paid","Partially Paid","Cancelled"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Payment_Method
			(
				type = picklist
				displayname = "Payment Method"
				maxchar = 100
				values = {"Cash","UPI","Debit/Credit Card","Bank Transfer"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Bill_Date
			(
    			type = date
				displayname = "Bill Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Billing_ID
			(
    			type = text
				displayname = "Billing ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Consultation
		{
			success message = "Consultation Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Appointment
			(
				type = picklist	
				values  = Appointment.ID
    			displayformat = [Appointment_Date]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Patient
			(
				type = picklist	
				values  = Patient.ID
    			displayformat = [Patient_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Doctor
			(
				type = picklist	
				values  = Doctor.ID
    			displayformat = [Doctor]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Consultation_Date
			(
    			type = date
				displayname = "Consultation Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Symptoms
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Diagnosis
			(
    			type = textarea
				displayname = "Clinical Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Diagnosis1
			(
    			type = textarea
				displayname = "Diagnosis"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Blood_Pressure
			(
    			type = text
				displayname = "Blood Pressure"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Temperature
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Weight
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Follow_up_Date
			(
    			type = date
				displayname = "Follow-up Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Doctor_Recommendations
			(
    			type = textarea
				displayname = "Doctor Recommendations"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Consultation_ID
			(
    			type = text
				displayname = "Consultation ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Doctor
		{
			success message = "Doctor Added Successfully"
			SectionYears_of_Experience
			(
				type = section
				displayname = "SectionYears of Experience"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Doctor
			(
    			type = text
				displayname = "Doctor Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Specialization
			(
				type = picklist
				maxchar = 100
				values = {"General Medicine","Cardiology","Dermatology","Orthopedics","pediatrics","ENT","Neurology","Gynecology"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Phone_Number1
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Qualification
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Years_of_Experience
			(
				type = number
				displayname = "Years of Experience"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Consultation_Fee
			(
				displayname = "Consultation Fee"
				type = USD
				format = commadotwestern
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Availability
			(
				type = list	
				values = {"Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"}
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Active","Inactive","Leave"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Doctor_ID
			(
    			type = text
				displayname = "Doctor ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Medicine
		{
			success message = "Medicine Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Medicine_Name
			(
    			type = text
				displayname = "Medicine Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Generic_Name
			(
    			type = text
				displayname = "Generic Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Category
			(
				type = picklist
				maxchar = 100
				values = {"Tablet","Capsule","Syrup","Injection","Cream","Ointment","Drops"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Manufacturer
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Unit_Price
			(
				type = number
				displayname = "Unit Price"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Stock_Quantity
			(
				type = number
				displayname = "Stock Quantity"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Expiry_Date
			(
    			type = date
				displayname = "Expiry Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Status
			(
				type = picklist
				maxchar = 100
				values = {"Available","Low Stock","Out of Stock","Expired","Inactive"}
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Patient
		{
			success message = "Patient Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Patient_Name
			(
    			type = text
				displayname = "Patient Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Date_of_Birth
			(
    			type = date
				displayname = "Date of Birth"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Gender
			(
				type = radiobuttons
				maxchar = 100
				values = {"Male","Female","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Phone_Number
			(
    			type = text
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Blood_Group
			(
				type = picklist
				displayname = "Blood Group"
				maxchar = 100
				values = {"A-","A+","B+","B-","AB+","AB-","O+","O-"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Date_field
			(
    			type = date
				displayname = "Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Patient_ID
			(
    			type = text
				displayname = "Patient ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Prescription
		{
			success message = "Prescription Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Consultation
			(
				type = picklist	
				values  = Consultation.ID
    			displayformat = [Consultation_Date]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Medicine
			(
				type = picklist	
				values  = Medicine.ID
    			displayformat = [Medicine_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Dosage
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Frequency
			(
				type = picklist
				maxchar = 100
				values = {"Once Daily","Twice Daily","Three Times Daily","Four Times Daily","As Needed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Duration
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Instructions
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Quantity
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Patients
		{
			displayName = "All Patients"
			show all rows from Patient    
			(
				Patient_Name as "Patient Name"
				Date_of_Birth as "Date of Birth"
				Gender
				Phone_Number as "Phone Number"
				Email
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Blood_Group as "Blood Group"
				Date_field as "Date"
				Patient_ID as "Patient ID"
			)
		}
		default list All_Doctors
		{
			displayName = "All Doctors"
			show all rows from Doctor    
			(
				Doctor as "Doctor Name"
				Specialization
				Phone_Number1 as "Phone Number"
				(
					displayformat = plainnumber 
				)
				Email
				Qualification
				Years_of_Experience as "Years of Experience"
				Consultation_Fee as "Consultation Fee"
				Availability
				Status
				Doctor_ID as "Doctor ID"
			)
		}
		default list All_Appointments
		{
			displayName = "All Appointments"
			show all rows from Appointment    
			(
				Patient
				Doctor
				Appointment_Date as "Appointment Date"
				Appointment_Time as "Appointment Time"
				Reason_for_Visit as "Reason for Visit"
				Appointment_Type as "Appointment Type"
				Status
				Notes
				Appointment_ID as "Appointment ID"
			)
		}
		default list All_Consultations
		{
			displayName = "All Consultations"
			show all rows from Consultation    
			(
				Appointment
				Patient
				Doctor
				Consultation_Date as "Consultation Date"
				Symptoms
				Diagnosis as "Clinical Notes"
				Diagnosis1 as "Diagnosis"
				Blood_Pressure as "Blood Pressure"
				Temperature
				Weight
				Follow_up_Date as "Follow-up Date"
				Doctor_Recommendations as "Doctor Recommendations"
				Consultation_ID as "Consultation ID"
			)
		}
		default list All_Medicines
		{
			displayName = "All Medicines"
			show all rows from Medicine    
			(
				Medicine_Name as "Medicine Name"
				Generic_Name as "Generic Name"
				Category
				Manufacturer
				Unit_Price as "Unit Price"
				Stock_Quantity as "Stock Quantity"
				Expiry_Date as "Expiry Date"
				Status
			)
		}
		default list All_Prescriptions
		{
			displayName = "All Prescriptions"
			show all rows from Prescription    
			(
				Consultation
				Medicine
				Dosage
				Frequency
				Duration
				Instructions
				Quantity
			)
		}
		default list All_Billings
		{
			displayName = "All Billings"
			show all rows from Billing    
			(
				Patient
				Appointment
				Consultation_Fee as "Consultation Fee"
				Medicine_Charges as "Medicine Charges"
				Other_Charges as "Other Charges"
				Discount
				Total_Amount as "Total Amount"
				Payment_Status as "Payment Status"
				Payment_Method as "Payment Method"
				Bill_Date as "Bill Date"
				Billing_ID as "Billing ID"
			)
		}
	}
	pages
	{
		page Clinic_Dashboard(int today_appointments)
		{
			displayname = "Clinic Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='25%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '2px'\n\tpadding = '2px'\n\tcolor = '#0ABB51'\n\tsize = '40px'\n\tbold = 'true' \n\tfontFamily = 'roboto-regular' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '12px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t\tcriteria = 'Appointment_Date is today'\n\t  value = 'thisapp.Appointment.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '2px'\n\tpadding = '2px'\n\tcolor = '#FF0048'\n\tsize = '20px'\n\tbold = 'true' \n\titalic = 'true' \n\tfontFamily = 'arimo, sans-serif' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '13px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Today&apos;s Appointments'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='23%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '4px'\n\tmarginRight = '2px' \n\tmarginBottom = '2px'\n\tmarginTop = '2px'\n\tpadding = '2px'\n\tcolor = '#0ABB51'\n\tsize = '40px'\n\tbold = 'true' \n\tfontFamily = 'roboto-regular' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '12px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '1px'\n\n\t  value = 'thisapp.Patient.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '2px'\n\tpadding = '2px'\n\tcolor = '#FF0048'\n\tsize = '20px'\n\tbold = 'true' \n\tfontFamily = 'arimo, sans-serif' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '13px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Total Patients'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='25%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '2px'\n\tpadding = '2px'\n\tcolor = '#0ABB51'\n\tsize = '40px'\n\tbold = 'true' \n\tfontFamily = 'roboto-regular' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '12px'\n\n\n\tdisplayType = 'actual'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '1px'\n\n\t  value = 'thisapp.Doctor.ID.count'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '2px'\n\tpadding = '2px'\n\tcolor = '#FF0048'\n\tsize = '20px'\n\tbold = 'true' \n\tfontFamily = 'arimo, sans-serif' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '13px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Total Doctors'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='27%'\n   \t>\n\t<panel elementName='Panel 3'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '2px'\n\tmarginTop = '0px'\n\tpadding = '0px'\n\tcolor = '#0ABB51'\n\tsize = '40px'\n\tbold = 'true' \n\tfontFamily = 'roboto-regular' \n\ttype = 'Form Data'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '12px'\n\n\n\tdisplayType = 'actual'\n\tdecimalPlaces = '2'\n\tthousandsSeperator = 'COMMA'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = 'thisapp.Billing.Total_Amount.sum'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '2px'\n\tpadding = '2px'\n\tcolor = '#FF0048'\n\tsize = '20px'\n\tbold = 'true' \n\tfontFamily = 'arimo, sans-serif' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '13px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Total Revenue'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='48%'\n   \t>\n\t<chart \n\telementName='Chart'\n\n\t\n\ttitle = 'Today&apos;s Appointment Status'\n\t\n            boldTitle = 'true'\n\t\ttitleColor = '#FF0048'\n\ttype = 'Donut'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Appointment'\n\txfield = 'Status'\n\tyfields = 'count:Appointment_ID'\n\t\tDelugeCriteria = 'Appointment_Date is today'\n/>\n\n</column><column\n   \t\t width='52%'\n   \t>\n\t<chart \n\telementName='Chart 1'\n\n\t\n\ttitle = 'Appointments by Doctor'\n\t\n            boldTitle = 'true'\n\t\ttitleColor = '#FF0048'\n\ttype = 'Bar'\n\tytitle = 'Appointments'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Appointment'\n\txfield = 'Doctor.Doctor'\n\tyfields = 'count:Appointment_ID'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart 2'\n\n\t\n\ttitle = 'Billing Payment Status'\n\t\n            boldTitle = 'true'\n\t\ttitleColor = '#FF0048'\n\ttype = 'Donut'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Billing'\n\txfield = 'Payment_Status'\n\tyfields = 'count:Billing_ID'\n/>\n\n</column><column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart 3'\n\n\ttype = 'Bar'\n\txtitle = ' Medicine Name'\n\tytitle = 'Sum of Stock Quantity'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Medicine'\n\txfield = 'Medicine_Name'\n\tyfields = 'sum:Stock_Quantity'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'All_Appointments'\n\t\tcriteriaString = 'Appointment_Date is today || Appointment_Date in next 30 days'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column><column\n   \t\t width='50%'\n   \t>\n\t<chart \n\telementName='Chart 4'\n\n\t\n\ttitle = 'Appointment Trend'\n\t\n            boldTitle = 'true'\n\t\ttitleColor = '#FF0048'\n\ttype = 'Line'\n\txtitle = 'Appointment Date'\n\tytitle = 'Count of Appointment ID'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Appointment'\n\txfield = 'Appointment_Date'\n\tyfields = 'count:Appointment_ID'\n/>\n\n</column>\n</row>\n</layout>\n</zml>"
			script
			{
				input.today_appointments = Appointment[Appointment_Date == zoho.currentdate].count();
			}
		}
		page Clinic_Dashboard1(int Active_doctors, int Cancelled_appointments, int Completed_appointments, int Low_stock_medicines, int Out_of_stock_medicines, int Paid_bills, int Pending_appointments, int Pending_payments, int Today_appointments, int Total_bills, int Total_doctors, int Total_patients, int Total_revenue)
		{
			displayname = "Clinic Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t\n</layout>\n</zml>"
			script
			{
				// ================================
				// CLINIC MANAGEMENT DASHBOARD
				// ================================
				// Patient statistics
				input.Total_patients = Patient.count();
				// Doctor statistics
				input.Total_doctors = Doctor.count();
				input.Active_doctors = Doctor[Status == "Active"].count();
				// Appointment statistics
				input.Today_appointments = Appointment[Appointment_Date == zoho.currentdate].count();
				input.Pending_appointments = Appointment[Status == "Pending"].count();
				input.Completed_appointments = Appointment[Status == "Completed"].count();
				input.Cancelled_appointments = Appointment[Status == "Cancelled"].count();
				// Billing statistics
				input.Total_bills = Billing.count();
				input.Total_revenue = ifnull(Billing.sum(Total_Amount),0);
				input.Pending_payments = Billing[Payment_Status == "Pending"].count();
				input.Paid_bills = Billing[Payment_Status == "Paid"].count();
				// Medicine inventory statistics
				input.Low_stock_medicines = Medicine[Status == "Low Stock"].count();
				input.Out_of_stock_medicines = Medicine[Status == "Out of Stock"].count();
			}
		}
	}




		workflow
		{
		form
		{
			Appointment_Creation_Work as "Appointment Creation Workflow"
			{
				type =  form
				form = Appointment

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											existing_appointments = Appointment[Doctor == input.Doctor && Appointment_Date == input.Appointment_Date && Appointment_Time == input.Appointment_Time];
										if(existing_appointments.count() > 0)
										{
											alert "This doctor already has an appointment at the selected date and time.";
											cancel submit;
										}
						)
					}
				}

			}
			Automatic_Bill_Calculatio as "Automatic Bill Calculation"
			{
				type =  form
				form = Billing

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											consultation_fee = ifnull(input.Consultation_Fee,0);
										medicine_charges = ifnull(input.Medicine_Charges,0);
										other_charges = ifnull(input.Other_Charges,0);
										discount = ifnull(input.Discount,0);
										input.Total_Amount = consultation_fee + medicine_charges + other_charges - discount;
						)
					}
				}

			}
			Generate_Patient_ID as "Generate Patient ID"
			{
				type =  form
				form = Patient

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											patient_count = Patient.count();
										next_number = patient_count + 1;
										if(next_number < 10)
										{
											patient_number = "000" + next_number.toString();
										}
										else if(next_number < 100)
										{
											patient_number = "00" + next_number.toString();
										}
										else if(next_number < 1000)
										{
											patient_number = "0" + next_number.toString();
										}
										else
										{
											patient_number = next_number.toString();
										}
										input.Patient_ID = "PAT-" + patient_number;
						)
					}
				}

			}
			Generate_Doctor_ID as "Generate Doctor ID"
			{
				type =  form
				form = Doctor

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											doctor_count = Doctor.count();
										next_number = doctor_count + 1;
										if(next_number < 10)
										{
											doctor_number = "000" + next_number.toString();
										}
										else if(next_number < 100)
										{
											doctor_number = "00" + next_number.toString();
										}
										else if(next_number < 1000)
										{
											doctor_number = "0" + next_number.toString();
										}
										else
										{
											doctor_number = next_number.toString();
										}
										input.Doctor_ID = "DOC-" + doctor_number;
						)
					}
				}

			}
			Generate_Appointment_ID as "Generate Appointment ID"
			{
				type =  form
				form = Appointment

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											appointment_count = Appointment.count();
										next_number = appointment_count + 1;
										if(next_number < 10)
										{
											appointment_number = "000" + next_number.toString();
										}
										else if(next_number < 100)
										{
											appointment_number = "00" + next_number.toString();
										}
										else if(next_number < 1000)
										{
											appointment_number = "0" + next_number.toString();
										}
										else
										{
											appointment_number = next_number.toString();
										}
										input.Appointment_ID = "APT-" + appointment_number;
						)
					}
				}

			}
			Generate_Consultation_ID as "Generate Consultation ID"
			{
				type =  form
				form = Consultation

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											consultation_count = Consultation.count();
										next_number = consultation_count + 1;
										if(next_number < 10)
										{
											consultation_number = "000" + next_number.toString();
										}
										else if(next_number < 100)
										{
											consultation_number = "00" + next_number.toString();
										}
										else if(next_number < 1000)
										{
											consultation_number = "0" + next_number.toString();
										}
										else
										{
											consultation_number = next_number.toString();
										}
										input.Consultation_ID = "CON-" + consultation_number;
						)
					}
				}

			}
			Generate_Billing_ID as "Generate Billing ID"
			{
				type =  form
				form = Billing

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											billing_count = Billing.count();
										next_number = billing_count + 1;
										if(next_number < 10)
										{
											billing_number = "000" + next_number.toString();
										}
										else if(next_number < 100)
										{
											billing_number = "00" + next_number.toString();
										}
										else if(next_number < 1000)
										{
											billing_number = "0" + next_number.toString();
										}
										else
										{
											billing_number = next_number.toString();
										}
										input.Billing_ID = "BILL-" + billing_number;
						)
					}
				}

			}
			Update_Medicine_Stock as "Update Medicine Stock"
			{
				type =  form
				form = Prescription

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											medicine_record = Medicine[ID == input.Medicine];
										if(medicine_record.count() > 0)
										{
											current_stock = ifnull(medicine_record.Stock_Quantity,0);
											prescribed_quantity = ifnull(input.Quantity,0);
											if(prescribed_quantity <= 0)
											{
												alert "Quantity must be greater than zero.";
												cancel submit;
											}
											else if(prescribed_quantity > current_stock)
											{
												alert "Insufficient medicine stock. Available stock: " + current_stock.toString();
												cancel submit;
											}
											else
											{
												new_stock = current_stock - prescribed_quantity;
												medicine_record.Stock_Quantity=new_stock;
												if(new_stock == 0)
												{
													medicine_record.Status="Out of Stock";
												}
												else if(new_stock <= 10)
												{
													medicine_record.Status="Low Stock";
												}
												else
												{
													medicine_record.Status="Available";
												}
											}
										}
						)
					}
				}

			}
		}

		schedule
		{
			Daily_Appointment_Reminde as "Daily Appointment Reminder"
			{
				type =  schedule
				form = Appointment
					status = inactive
				start = Appointment_Date at "08:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
				}
			}
		}

		approval
		{
			Create_Appointment_Approv as "Create Appointment Approval"
			{
				type =  approval
				form = Appointment
				display fields = [Patient,Doctor,Appointment_Date,Appointment_Time,Reason_for_Visit,Appointment_Type,Status]
				on start
				{
				}
				on level 1
				{
					approvers
					(
			 			role = "CEO"
					)
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
					}
				}
			}
		}



	}
